# Dependencies
node_modules/

# Build output
client/dist/

# Local environment
.env

# Database (re-create with `npm run seed`)
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm

# Uploads — cover art and avatars are generated by `npm run seed`, and user
# uploads land here at runtime, so nothing in these folders is tracked.
server/uploads/covers/*
server/uploads/avatars/*
server/uploads/videos/*
server/uploads/misc/*
!server/uploads/**/.gitkeep

# Logs & OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editors
.idea/
*.swp

# Deliverable archive (kept out of git; rebuild with the zip command in the README)
eventtracker.zip

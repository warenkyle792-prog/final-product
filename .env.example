# Development-only example. Copy to .env and edit for your environment.
# NEVER reuse these values in production; server/config.js validates production secrets.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5000
# TRUST_PROXY=1
# FRAME_ANCESTORS='none'
COOKIE_SECURE=false
JWT_SECRET=local-development-jwt-secret-change-this-value-000000
TICKET_SECRET=local-development-ticket-secret-change-this-value-000000
SESSION_DAYS=30
TOKEN_DAYS=30
# DATA_DIR=./data
# DB_FILE=./data/eventtracker.sqlite
# UPLOADS_DIR=./data/uploads
# UPLOAD_JSON_LIMIT=2mb
RATE_LIMIT_GENERAL=240
RATE_LIMIT_AUTH=12
RATE_LIMIT_UPLOADS=24
RATE_LIMIT_VERIFY=60
RATE_LIMIT_SENSITIVE=30
RATE_LIMIT_WINDOW_MS=900000
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# MPESA_CALLBACK_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Google sign-in (optional; the button reports "not configured" without these)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# EventTracker — environment
# Copy to .env and edit. Values below are for local development only.

NODE_ENV=development
PORT=5000

# Where the browser talks to the app (Vite dev server) and the API itself.
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Behind a platform proxy set the number of trusted hops; disable with "false".
# TRUST_PROXY=1

# Framing policy. Defaults to same-origin; list origins (space/comma separated)
# when the app is embedded, e.g. in a sandbox preview.
# FRAME_ANCESTORS='self'

# Secrets: generate unique random values for any real deployment.
JWT_SECRET=local-development-jwt-secret-change-this-value-000000
TICKET_SECRET=local-development-ticket-secret-change-this-value-000000
SESSION_DAYS=30
TOKEN_DAYS=30
COOKIE_SECURE=false

# Data locations (defaults shown).
# DATA_DIR=./server/data
# DB_FILE=./server/data/eventtracker.db
# UPLOADS_DIR=./server/uploads
# UPLOAD_JSON_LIMIT=12mb

# Rate limits.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AUTH=120
RATE_LIMIT_UPLOADS=60
RATE_LIMIT_VERIFY=30
RATE_LIMIT_SENSITIVE=20

# Payments — left unset, both providers run in local simulation mode.
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=
# MPESA_CALLBACK_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
